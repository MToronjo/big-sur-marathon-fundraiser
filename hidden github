name: Update fundraising total

on:
  workflow_dispatch:
  schedule:
    - cron: "23 * * * *"   # hourly

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.x"
      - name: Read live Haku total
        run: python scripts/update_fundraising.py
      - name: Commit if changed
        run: |
          if git diff --quiet -- fundraising-data.json; then
            echo "No change."; exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add fundraising-data.json
          git commit -m "Update fundraising total"
          git push
